import { VerticalBox } from "std-widgets.slint";

export struct Item {
    id: string,
    channel: string,
    frequency: int,
    conflict: bool,
    selected: bool,
}

export component AppWindow inherits Window {
    title: "FPV Frequency Table";
    preferred-width: 360px;
    preferred-height: 640px;
    background: #f8fafc;

    in-out property <[Item]> model;
    in-out property <string> statusText: "Tap a channel tile to select.";

    callback item-clicked(Item);

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "FPV Channels";
            font-size: 22px;
            font-weight: 700;
            color: #0f172a;
            horizontal-alignment: center;
        }

        // Status Bar
        Rectangle {
            background: #e2e8f0;
            border-radius: 8px;
            height: 32px;

            Text {
                text: root.statusText;
                font-size: 13px;
                color: #475569;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        // Touch-enabled scrolling container
        Flickable {
            vertical-stretch: 1;
            interactive: true;

            GridLayout {
                spacing: 12px;
                padding-bottom: 16px;

                for item[index] in root.model: Rectangle {
                    col: mod(index, 2);
                    row: floor(index / 2);
                    width: 154px;
                    height: 100px;
                    border-radius: 12px;

                    background: item.selected
                        ? #dbeafe
                        : (item.conflict
                        ? #fef2f2
                        : (card-touch.has-hover ? #e2e8f0 : #ffffff));

                    border-width: item.selected ? 2px : 1px;
                    border-color: item.selected
                        ? #2563eb
                        : (item.conflict ? #fca5a5 : #e2e8f0);

                    // Touch Area set to yield dragging events up to parent Flickable
                    card-touch := TouchArea {
                        enabled: !item.conflict || item.selected;

                        clicked => {
                            root.item-clicked(item);
                        }
                    }

                    VerticalBox {
                        padding: 12px;
                        spacing: 4px;

                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: item.channel;
                                font-size: 16px;
                                font-weight: 700;
                                color: item.selected
                                    ? #1e40af
                                    : (item.conflict ? #991b1b : #0f172a);
                            }

                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: item.selected
                                    ? #2563eb
                                    : (item.conflict ? #ef4444 : #10b981);
                            }
                        }

                        Text {
                            text: item.frequency + " MHz";
                            font-size: 13px;
                            color: item.selected
                                ? #1d4ed8
                                : (item.conflict ? #991b1b : #64748b);
                        }

                        Text {
                            text: item.selected
                                ? "Active"
                                : (item.conflict ? "Blocked (Conflict)" : "Available");
                            font-size: 11px;
                            font-weight: 600;
                            color: item.selected
                                ? #1d4ed8
                                : (item.conflict ? #dc2626 : #059669);
                        }
                    }
                }
            }
        }
    }
}
